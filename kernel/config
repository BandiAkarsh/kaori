# Edge OS — Linux Kernel Configuration (Linux 7.0.10)
#
# Principles:
#   1. DESKTOP OPTIMIZED — full preempt, 1000Hz, performance governor by default
#   2. ADVANCED SCHEDULING — EEVDF (default) + sched_ext (BPF scheduler) + MGLRU
#   3. x86-64 BASELINE — no v3/v4 optimizations (portable to any x86-64 CPU)
#   4. ALGORITHMIC ADVANCEMENT — DAMON proactive reclaim, BBR3, LLVM ThinLTO
#   5. Driver coverage — GPU, sound, net, WiFi, BT, input, storage, USB
#   6. Security hardened — stackprotector, module signing, lockdown, SELinux, AppArmor
#   7. Fast boot — stripped drivers, no unnecessary probing, no TPM wait
#   8. Btrfs native — ZSTD max compression, send/receive, quotas, auto-defrag
#   9. Container-friendly — OverlayFS, FUSE, SquashFS, Netfilter, IPv6, namespaces
#  10. Virtualization — QEMU/KVM VirtIO, 9P, guest tools
#
# Build:
#   make LLVM=1 LLVM_IAS=1 -j$(nproc) bzImage

# ─── General Setup ───
CONFIG_LOCALVERSION="-edge"
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_KERNEL_XZ=y

# ─── Processor & Architecture (x86-64 baseline — no v3/v4) ───
CONFIG_X86_64=y
CONFIG_GENERIC_CPU=y
# CONFIG_GENERIC_CPU3 is not set
# CONFIG_GENERIC_CPU4 is not set
# CONFIG_MATOM is not set
# CONFIG_MCORE2 is not set

# ─── Scheduler: EEVDF (default since 6.6) + sched_ext (BPF) ───
# EEVDF is the upstream default, replacing CFS — no special config needed
# sched_ext: BPF-based schedulers (6.12 feature — loadable at runtime)
CONFIG_SCHED_CLASS_EXT=y

# ─── Desktop Preemption (full preempt for low-latency desktop) ───
CONFIG_PREEMPT=y
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT_NONE is not set

# ─── Timer frequency (1000Hz for desktop responsiveness) ───
CONFIG_HZ_1000=y
# CONFIG_HZ_250 is not set
# CONFIG_HZ_300 is not set
CONFIG_HZ=1000

# ─── Auto-group scheduling (better desktop interactivity) ───
CONFIG_SCHED_AUTOGROUP=y

# ─── CPU Frequency (PERFORMANCE governor by default) ───
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_POWERSAVE is not set

# ─── Intel P-state (for modern Intel CPUs) ───
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_ACPI_CPUFREQ=y
# CONFIG_X86_ACPI_CPUFREQ_CPB is not set

# ─── CPU idle (deep C-states for battery life) ───
CONFIG_CPU_IDLE=y
CONFIG_INTEL_IDLE=y
CONFIG_HALTPOLL_CPUIDLE=y

# ─── Memory Management: MGLRU + DAMON (advanced algorithms) ───
# MGLRU: Multi-Gen LRU — O(1) page reclaim, dramatically reduces memory pressure
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# DAMON: Data Access MONitor — proactive reclaim, access-aware memory management
CONFIG_DAMON=y
CONFIG_DAMON_VADDR=y
CONFIG_DAMON_PADDR=y
CONFIG_DAMON_SYSFS=y
CONFIG_DAMON_DBGFS=y

# ─── Memory Compression / Swap: zram with zstd ───
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
# CONFIG_ZRAM_DEF_COMP_LZORLE is not set
CONFIG_FRONTSWAP=y

# ─── Security: lockdown + module signing + SELinux + AppArmor + hardening ───
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA256=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_INTEGRITY=y
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_LSM="lockdown,integrity,apparmor,selinux,yama,bpf"

# Memory hardening — zero-init alloc/free, prevent info leaks
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_IO_STRICT_DEVMEM=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_CREDENTIALS=y

